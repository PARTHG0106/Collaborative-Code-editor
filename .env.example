# ============================================
# Collaborative Code Editor - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collab_editor?schema=public"

# Server
# The server defaults to 3000 and the Vite dev proxy targets 3000, so keep
# these in step. Production (Hugging Face Space) uses 7860.
PORT=3000
NODE_ENV=development

# Comma-separated list of browser origins allowed to make credentialed
# requests. Required in production; there is no wildcard-everything fallback
# because credentials are attached to these requests.
# A single "*" per entry is supported for generated preview hostnames, e.g.
#   https://my-app-*.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Isolated workspace terminal. The Docker image supplies the Linux sandbox.
ENABLE_TERMINAL=true
# The existing Space uses a local offline filesystem/process sandbox.
# Its commands cannot make network connections; the API still can.
RUNTIME_PROVIDER=local

# JWT — must be at least 32 characters. The server refuses to boot on missing,
# short, or placeholder values rather than falling back to a default secret.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Identity Services web client ID (public; no client secret is needed).
# Add frontend origins to this OAuth client and to CORS_ORIGINS above.
GOOGLE_CLIENT_ID=

# Frontend — these are baked into the bundle at BUILD time, not read at
# runtime. If they are unset when the frontend is built, the compiled app will
# call http://localhost:3000/api from every visitor's browser.
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# Docker PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collab_editor

# Mailer (for Email Verification in Production)
# Leave empty for development mock mode (logs code to terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# Optional file/snapshot content storage. Auth, permissions and metadata stay
# in PostgreSQL. Initialize/migrate using docs/cloudflare-d1-content.md first.
FILE_CONTENT_STORAGE=postgres
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
# Optional one-time startup migration of existing file/snapshot contents.
D1_BACKFILL_ON_START=false
# Optional fine-grained read token restricted to the existing GPU Space.
# Never send the account's deployment/write HF_TOKEN to user-code workers.
HF_GPU_TOKEN=
