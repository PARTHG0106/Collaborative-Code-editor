.turbo/

# Prisma
# migration_lock.toml is intentionally NOT ignored: Prisma expects it to be
# committed so it can detect a provider mismatch between the migrations and the
# target database. `migrate deploy` warns when it is missing.
apps/server/prisma/*.db

# Docker
docker-data/

# Misc
*.tsbuildinfo

# Build artifact: tsc -b emits this next to the vite.config.ts source
apps/web/vite.config.js

# Generated Prisma client (output is set to src/generated/client in schema.prisma)
apps/server/src/generated/

# Local scratch
.prisma/cli/state.json
